[Unit]
Description=Renew the Pet Clinic Let's Encrypt certificate
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/docker run --rm --name petclinic-certbot-renew -v /home/ec2-user/certbot/conf:/etc/letsencrypt -v /home/ec2-user/certbot/www:/var/www/certbot certbot/certbot renew --webroot -w /var/www/certbot --quiet
ExecStartPost=/usr/bin/docker exec petclinic-nginx nginx -s reload

