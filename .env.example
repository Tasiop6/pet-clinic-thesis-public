# Copy this file to .env and replace every CHANGE_ME value before deployment.
# The real .env file is intentionally ignored by Git.

MYSQL_DATABASE=petclinic
MYSQL_USER=petclinic
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DATABASE_PASSWORD

# Use at least 32 random bytes for HS256 signing.
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_JWT_SECRET

APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
APP_BOOTSTRAP_ADMIN_EMAIL=admin@petclinic.local

# Leave these empty if Google Calendar integration is not used.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://thesis-tasiopoulos.com/auth/google/callback

# Amazon SES SMTP settings. Use SES-generated SMTP credentials, not AWS access keys.
SPRING_MAIL_HOST=email-smtp.eu-central-1.amazonaws.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=CHANGE_ME_SES_SMTP_USERNAME
SPRING_MAIL_PASSWORD=CHANGE_ME_SES_SMTP_PASSWORD
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
CLINIC_NOTIFICATIONS_FROM=CHANGE_ME_VERIFIED_SES_SENDER
CLINIC_PUBLIC_BASE_URL=https://thesis-tasiopoulos.com
EMAIL_VERIFICATION_TOKEN_HOURS=24
PASSWORD_RESET_TOKEN_MINUTES=60
